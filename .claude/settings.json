{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run mypy *)",
      "mcp__dbhub__execute_sql_local_ro",
      "mcp__dbhub__execute_sql_hetzner_ro"
    ],
    "ask": [
      "mcp__dbhub__execute_sql_local_rw",
      "mcp__dbhub__execute_sql_hetzner_rw"
    ]
  },
  "hooks": {
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{"type": "command", "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) cd \"$CLAUDE_PROJECT_DIR\" && uv run ruff check --fix \"$f\" && uv run mypy \"$f\" ;; esac"}]
    }]
  }
}

# User-level service — install to ~/.config/systemd/user/
# See deploy/snapshot_company.timer for the schedule and full deploy steps.
[Unit]
Description=Monthly turtle.company snapshot to company_history
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/turtle-backtest
EnvironmentFile=%h/.config/turtle-backtest/secrets.env
ExecStart=%h/.local/bin/uv run snapshot-company
StandardOutput=journal
StandardError=journal

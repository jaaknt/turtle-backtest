# User-level service — install to ~/.config/systemd/user/
# Daily incremental price-history download (Mon-Sat), then the signal scan that
# persists to turtle.signal.
# See deploy/eodhd-download-daily.timer for the schedule.
[Unit]
Description=Turtle EODHD Daily History Download and Signal Scan
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/turtle-backtest
EnvironmentFile=%h/.config/turtle-backtest/secrets.env
ExecStart=%h/.local/bin/uv run download-eodhd-data --data history
# Rolling 7-day window, not a single day: a signal's next_open only lands once a later bar
# exists, so re-scanning the last week backfills it (docs/specs/web.md §1.4). The wider window
# cannot double-emit — the cooldown loop runs over the full warmup window before filtering to
# start_date. systemd does no command substitution of its own, hence /bin/sh -c.
ExecStart=/bin/sh -c 'exec %h/.local/bin/uv run signal-runner --trading-strategy qullamaggie --ranking-strategy qullamaggie --persist --persist-label bk50d_s12_v2.0 --start-date "$(date -I -d "7 days ago")" --end-date "$(date -I)"'
StandardOutput=journal
StandardError=journal

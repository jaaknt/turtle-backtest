# User-level service — install to ~/.config/systemd/user/
# Weekly full refresh (Sun): US ticker list, company fundamentals, price history.
# See deploy/eodhd-download-weekly.timer for the schedule.
[Unit]
Description=Turtle EODHD Weekly Full Download
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/turtle-backtest
EnvironmentFile=%h/.config/turtle-backtest/secrets.env
ExecStart=%h/.local/bin/uv run download-eodhd-data --data us_ticker
ExecStart=%h/.local/bin/uv run download-eodhd-data --data company
ExecStart=%h/.local/bin/uv run download-eodhd-data --data history
StandardOutput=journal
StandardError=journal
